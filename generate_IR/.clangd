CompileFlags:
  CompilationDatabase: build
  Add:
    - -std=c++20
    - -Wall
    - -Wextra
    - -Wpedantic
    - --target=x86_64-w64-mingw32
  Compiler: C:/ProgramData/mingw64/mingw64/bin/g++.exe

Diagnostics:
  ClangTidy:
    Add:
      - modernize-*
    Remove:
      - modernize-use-trailing-return-type
